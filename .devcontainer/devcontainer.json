{
  "name": "reqeng-template",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "customizations": {
    "vscode": {
      "extensions": [
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "ms-python.python"
      ],
      "settings": {
        "chat.promptFiles": true
      }
    }
  },
  "postCreateCommand": "echo 'ยังไม่มีโค้ด: library จะถูกติดตั้งเมื่อ /implement T-01 สร้างโครงโปรเจกต์ตาม plan.md ข้อ 2'",
  "forwardPorts": [
    5173,
    8000
  ],
  "portsAttributes": {
    "5173": {
      "label": "หน้าจอ (Vite)",
      "onAutoForward": "notify"
    }
  }
}